<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationTitle>ReFlow</ApplicationTitle>
    <AssemblyName>ReFlow</AssemblyName>
    <RootNamespace>ReFlow</RootNamespace>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
    <!-- Publish: only these cultures (satellites); UI strings are embedded JSON. -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Fonts\RobotoCondensed-Bold.ttf" />
    <Resource Include="Fonts\segoeui.ttf" />
    <Resource Include="Fonts\segoeuib.ttf" />
    <Resource Include="Fonts\segoeuil.ttf" />
    <Resource Include="Fonts\segoeuisl.ttf" />
    <Resource Include="Fonts\consolab.ttf" />
    <Resource Include="Fonts\SegMDL2.ttf" />
    <Resource Include="Assets\settings.svg" />
    <!-- Квадратные флаги для иконки региона: flag-icons 1x1 (MIT, см. Flags\LICENSE-flag-icons.txt), PNG 64x64; правки — Flags\src-overrides. -->
    <Resource Include="Flags\*.png" />
  </ItemGroup>

</Project>
