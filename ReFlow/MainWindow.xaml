<Window x:Class="ReFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:ReFlow"
        xmlns:controls="clr-namespace:ReFlow.Controls"
        Title="{DynamicResource Loc_Common_AppTitle}"
        Width="440" MinWidth="350"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        RenderTransformOrigin="0.5,0.5">
    <Window.Resources>
        <sys:Int32 x:Key="Rf.Tooltip.InitialShowDelayMs">100</sys:Int32>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo x:Name="TaskbarInfo"
                               ProgressState="None"
                               ProgressValue="0"/>
    </Window.TaskbarItemInfo>
    <Window.RenderTransform>
        <ScaleTransform x:Name="TrayHideScale" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Rf.Window.Background}"
            BorderBrush="{DynamicResource Rf.Border}"
            BorderThickness="1"
            ClipToBounds="False">
        <DockPanel>
            <!-- Заголовок: перетаскивание слева, три кнопки справа -->
            <Border DockPanel.Dock="Top"
                    Height="44"
                    Background="{DynamicResource Rf.Surface}"
                    BorderBrush="{DynamicResource Rf.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            Padding="14,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ReFlow" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="TitleBarAbout_OnMouseLeftButtonDown"/>
                                <Button Click="TitleBarAbout_OnClick"
                                        Style="{StaticResource Rf.TitleBar.AboutInfo}"/>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Rf.Text.Muted}"
                                       Text="{DynamicResource Loc_MainWindow_Subtitle}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnOpenSettings"
                                VerticalAlignment="Center"
                                Click="OpenSettings_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_Settings}"
                                Style="{StaticResource Rf.TitleBar.Settings}">
                            <Viewbox Width="14"
                                     Height="14"
                                     Stretch="Uniform">
                                <Path Fill="{x:Null}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.35"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M39.23 26a16.52 16.52 0 0 0 .14-2a16.52 16.52 0 0 0-.14-2l4.33-3.39a1 1 0 0 0 .25-1.31l-4.1-7.11a1 1 0 0 0-1.25-.44l-5.11 2.06a15.68 15.68 0 0 0-3.46-2l-.77-5.43a1 1 0 0 0-1-.86H19.9a1 1 0 0 0-1 .86l-.77 5.43a15.36 15.36 0 0 0-3.46 2L9.54 9.75a1 1 0 0 0-1.25.44l-4.1 7.11a1 1 0 0 0 .25 1.31L8.76 22a16.66 16.66 0 0 0-.14 2a16.52 16.52 0 0 0 .14 2l-4.32 3.39a1 1 0 0 0-.25 1.31l4.1 7.11a1 1 0 0 0 1.25.44l5.11-2.06a15.68 15.68 0 0 0 3.46 2l.77 5.43a1 1 0 0 0 1 .86h8.2a1 1 0 0 0 1-.86l.77-5.43a15.36 15.36 0 0 0 3.46-2l5.11 2.06a1 1 0 0 0 1.25-.44l4.1-7.11a1 1 0 0 0-.25-1.31ZM24 31.18A7.18 7.18 0 1 1 31.17 24A7.17 7.17 0 0 1 24 31.18Z"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnMinimizeToTray"
                                Click="TitleBarMinimizeToTray_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimizeToTray}"
                                Style="{StaticResource Rf.TitleBar.Button}"
                                Content="&#x2B07;"/>
                        <Button x:Name="BtnMinimize"
                                Click="TitleBarMinimize_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimize}"
                                Style="{StaticResource Rf.TitleBar.Button}"
                                Content="&#x2212;"/>
                        <Button x:Name="BtnClose"
                                Click="TitleBarClose_OnClick"
                                Style="{StaticResource Rf.TitleBar.Close}"
                                Content="&#x00D7;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="24,42,24,50" ClipToBounds="False">
                <Grid Panel.ZIndex="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Width="380"
                                Margin="0,4,0,0">
                        <!-- Габариты и CornerRadius как у SpeedRollingDigits: контур прогресса совпадает с рамкой циферблата. -->
                        <Grid Width="278"
                              Height="130"
                              HorizontalAlignment="Center">
                            <controls:SpeedRollingDigits x:Name="SpeedDial"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            <!-- Финальное свечение (резко появляется, плавно исчезает) -->
                            <Path x:Name="DialCompleteGlow"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="278"
                                  Height="130"
                                  Stretch="None"
                                  Stroke="#68e2cf"
                                  StrokeThickness="6"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="{x:Null}"
                                  Opacity="0"
                                  Visibility="Collapsed"
                                  IsHitTestVisible="False">
                                <Path.Effect>
                                    <DropShadowEffect ShadowDepth="0"
                                                      BlurRadius="18"
                                                      Opacity="1"
                                                      Color="#68e2cf"/>
                                </Path.Effect>
                            </Path>
                            <Path x:Name="DialProgressOutline"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="278"
                                  Height="130"
                                  Stretch="None"
                                  Stroke="#68e2cf"
                                  StrokeThickness="2.5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="{x:Null}"
                                  Opacity="1"
                                  SnapsToDevicePixels="False"
                                  Visibility="Collapsed"
                                  IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="SpeedStatsLine"
                                   FontSize="12"
                                   Foreground="{DynamicResource Rf.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,12,0,16"/>
                        <local:BandwidthMeter HorizontalAlignment="Center"
                                              SpeedMbps="{Binding CurrentMbps}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Margin="0,13,0,0">
                    <!-- График совпадает по габаритам с кнопкой, линия поверх (клики в кнопку) -->
                    <Grid Width="300"
                          Height="54"
                          ClipToBounds="False">
                        <Button x:Name="BtnStartStop"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Padding="22,12"
                                FontSize="18"
                                Style="{StaticResource Rf.Button.Accent}"
                                Click="StartStop_OnClick"
                                RenderTransformOrigin="0.5,0.5"
                                Content="{Binding StartStopText}">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="StartStopScale" ScaleX="1" ScaleY="1"/>
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StartStopScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="1" To="1.06" Duration="0:0:0.12"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="StartStopScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="1" To="1.06" Duration="0:0:0.12"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                        <Border x:Name="GraphClipHost"
                                Background="Transparent"
                                CornerRadius="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                SizeChanged="GraphClipHost_OnSizeChanged">
                            <Border.RenderTransform>
                                <TranslateTransform Y="2"/>
                            </Border.RenderTransform>
                            <Canvas x:Name="GraphCanvas"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Path x:Name="MiniGraphFillPath"
                                      Opacity="1"
                                      Stroke="{x:Null}"/>
                                <Path x:Name="MiniGraphPath"
                                      Stroke="{DynamicResource Rf.Accent}"
                                      StrokeThickness="2"
                                      Opacity="0.92"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="{x:Null}"/>
                            </Canvas>
                        </Border>
                    </Grid>
                    </StackPanel>
                </Grid>
                <!-- В нижнем отступе окна (Margin снизу), без увеличения высоты SizeToContent -->
                <TextBlock x:Name="SpeedTestDomainLine"
                           Panel.ZIndex="11"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource Rf.Text.Muted}"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300"
                           Margin="0,0,0,-31"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
