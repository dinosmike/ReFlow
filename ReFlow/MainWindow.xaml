<Window x:Class="ReFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:ReFlow"
        xmlns:controls="clr-namespace:ReFlow.Controls"
        Title="{DynamicResource Loc_Common_AppTitle}"
        Width="620" MinWidth="620"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        RenderTransformOrigin="0.5,0.5">
    <Window.Resources>
        <sys:Int32 x:Key="Rf.Tooltip.InitialShowDelayMs">100</sys:Int32>
    </Window.Resources>
    <Window.RenderTransform>
        <ScaleTransform x:Name="TrayHideScale" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Rf.Window.Background}"
            BorderBrush="{DynamicResource Rf.Border}"
            BorderThickness="1"
            ClipToBounds="False">
        <DockPanel>
            <!-- Заголовок: перетаскивание слева, три кнопки справа -->
            <Border DockPanel.Dock="Top"
                    Height="44"
                    Background="{DynamicResource Rf.Surface}"
                    BorderBrush="{DynamicResource Rf.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            Padding="14,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ReFlow" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="TitleBarAbout_OnMouseLeftButtonDown"/>
                                <Button Click="TitleBarAbout_OnClick"
                                        Style="{StaticResource Rf.TitleBar.AboutInfo}"/>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Rf.Text.Muted}"
                                       Text="{DynamicResource Loc_MainWindow_Subtitle}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnMinimizeToTray"
                                Click="TitleBarMinimizeToTray_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimizeToTray}"
                                Style="{StaticResource Rf.TitleBar.Button}"
                                Content="&#x2B07;"/>
                        <Button x:Name="BtnMinimize"
                                Click="TitleBarMinimize_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimize}"
                                Style="{StaticResource Rf.TitleBar.Button}"
                                Content="&#x2212;"/>
                        <Button x:Name="BtnClose"
                                Click="TitleBarClose_OnClick"
                                Style="{StaticResource Rf.TitleBar.Close}"
                                Content="&#x00D7;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="24,24,24,50" ClipToBounds="False">
                <Grid Panel.ZIndex="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnOpenSettingsCorner"
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource Rf.Button}"
                            Padding="10,6"
                            Click="OpenSettings_OnClick"
                            Content="⚙"/>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Width="380"
                                Margin="0,4,0,0">
                        <controls:SpeedRollingDigits x:Name="SpeedDial"
                                                      HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SpeedStatsLine"
                                   FontSize="12"
                                   Foreground="{DynamicResource Rf.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,12,0,16"/>
                        <local:BandwidthMeter HorizontalAlignment="Center"
                                              SpeedMbps="{Binding CurrentMbps}"/>
                    </StackPanel>

                    <!-- График совпадает по габаритам с кнопкой, линия поверх (клики в кнопку) -->
                    <Grid Grid.Row="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,13,0,0"
                          Width="300"
                          Height="54"
                          ClipToBounds="True">
                        <Button x:Name="BtnStartStop"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Padding="22,12"
                                FontSize="18"
                                Style="{StaticResource Rf.Button.Accent}"
                                Click="StartStop_OnClick"
                                RenderTransformOrigin="0.5,0.5"
                                Content="{Binding StartStopText}">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="StartStopScale" ScaleX="1" ScaleY="1"/>
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StartStopScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="1" To="1.06" Duration="0:0:0.12"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="StartStopScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="1" To="1.06" Duration="0:0:0.12"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                        <Border x:Name="GraphClipHost"
                                Background="Transparent"
                                CornerRadius="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                SizeChanged="GraphClipHost_OnSizeChanged">
                            <Border.RenderTransform>
                                <TranslateTransform Y="2"/>
                            </Border.RenderTransform>
                            <Canvas x:Name="GraphCanvas"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Path x:Name="MiniGraphFillPath"
                                      Opacity="1"
                                      Stroke="{x:Null}"/>
                                <Path x:Name="MiniGraphPath"
                                      Stroke="{DynamicResource Rf.Accent}"
                                      StrokeThickness="2"
                                      Opacity="0.92"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="{x:Null}"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
