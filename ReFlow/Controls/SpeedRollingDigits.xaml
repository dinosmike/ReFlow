<UserControl x:Class="ReFlow.Controls.SpeedRollingDigits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="278"
             Height="130">
    <Border x:Name="DigitBorder"
            CornerRadius="20"
            BorderBrush="{DynamicResource Rf.Border}"
            BorderThickness="1.5"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#141D2B" Offset="0"/>
                <GradientStop Color="#1B263A" Offset="0.5"/>
                <GradientStop Color="#141D2B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid Background="Transparent">
            <Rectangle VerticalAlignment="Center" Height="1"
                       Fill="#18FFFFFF" IsHitTestVisible="False"
                       Margin="8,0"/>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="76" ClipToBounds="True" VerticalAlignment="Stretch">
                    <TextBlock x:Name="CurH"
                               Text="0"
                               FontSize="80"
                               FontWeight="Bold"
                               FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                               Foreground="{DynamicResource Rf.Text.Primary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CurHTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="IncH"
                               Text="0"
                               FontSize="80"
                               FontWeight="Bold"
                               FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                               Foreground="{DynamicResource Rf.Text.Primary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="IncHTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <Grid Grid.Column="1" Width="76" ClipToBounds="True" VerticalAlignment="Stretch">
                    <TextBlock x:Name="CurT"
                               Text="0"
                               FontSize="80"
                               FontWeight="Bold"
                               FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                               Foreground="{DynamicResource Rf.Text.Primary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CurTTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="IncT"
                               Text="0"
                               FontSize="80"
                               FontWeight="Bold"
                               FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                               Foreground="{DynamicResource Rf.Text.Primary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="IncTTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <Grid Grid.Column="2" Width="76" ClipToBounds="True" VerticalAlignment="Stretch">
                    <TextBlock x:Name="CurO"
                               Text="0"
                               FontSize="80"
                               FontWeight="Bold"
                               FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                               Foreground="{DynamicResource Rf.Text.Primary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CurOTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="IncO"
                               Text="0"
                               FontSize="80"
                               FontWeight="Bold"
                               FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                               Foreground="{DynamicResource Rf.Text.Primary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="IncOTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>

            <Rectangle VerticalAlignment="Top" Height="28" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A0141D2B" Offset="0"/>
                        <GradientStop Color="#00141D2B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle VerticalAlignment="Bottom" Height="28" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00141D2B" Offset="0"/>
                        <GradientStop Color="#A0141D2B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Border>
</UserControl>
