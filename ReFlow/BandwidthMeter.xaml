<UserControl x:Class="ReFlow.BandwidthMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="278"
             MinWidth="278"
             MaxWidth="278"
             HorizontalAlignment="Center"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Rf.BandwidthMeter.ScaleLabel" Color="#7D8694"/>
    </UserControl.Resources>
    <StackPanel>
        <Border x:Name="TrackShell"
                Height="16"
                CornerRadius="8"
                Background="#12161C"
                BorderBrush="{DynamicResource Rf.Border}"
                BorderThickness="1">
            <Grid>
                <!-- Внутренняя дорожка без Padding: так края всегда идеальная "пилюля". -->
                <Border x:Name="TrackInnerBorder"
                        Margin="1"
                        Height="14"
                        CornerRadius="7"
                        Background="#1E252E"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        ClipToBounds="True">
                    <Grid x:Name="TrackInner" ClipToBounds="True">
                        <Path x:Name="FillPath"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True"
                              Stroke="{x:Null}">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <!-- Начало градиента = фон трека, чтобы край скругления не выглядел "грязно". -->
                                    <GradientStop Color="#1E252E" Offset="0"/>
                                    <GradientStop Color="{DynamicResource Rf.Color.Accent}" Offset="0.55"/>
                                    <GradientStop Color="#7AE8D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Grid ClipToBounds="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="MarkerXform" X="0"/>
                            </Grid.RenderTransform>
                            <Ellipse Width="12"
                                     Height="12"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="-6,-2,0,0"
                                     Fill="{DynamicResource Rf.Surface}"
                                     Stroke="{DynamicResource Rf.Accent}"
                                     StrokeThickness="2">
                                <!-- Временно убрали тень: она может визуально "съедать" нижний левый радиус заливки. -->
                            </Ellipse>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Обводка трека поверх всего (не клипуется внутренним Border). -->
                <Border x:Name="TrackOutline"
                        Margin="1"
                        BorderBrush="{DynamicResource Rf.BandwidthMeter.TrackOutlineBrush}"
                        BorderThickness="1"
                        Background="Transparent"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        IsHitTestVisible="False"
                        Panel.ZIndex="999"/>
            </Grid>
        </Border>

        <Grid Margin="0,3,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="7"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Риски шкалы над цифрами -->
            <Rectangle Grid.Row="0" Grid.Column="0" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="1" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="2" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="3" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="4" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="5" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="6" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="7" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
            <Rectangle Grid.Row="0" Grid.Column="8" Width="1" Height="6" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Rf.Text.Muted}" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="0" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="5" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="10" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="50" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="100" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="5" Text="250" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="6" Text="500" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="7" Text="750" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="8" Text="1000" FontSize="9" Foreground="{StaticResource Rf.BandwidthMeter.ScaleLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
