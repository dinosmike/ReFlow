<Window x:Class="ReFlow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Loc_SettingsWindow_Title}"
        Width="520"
        MinHeight="400"
        MinWidth="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent">
    <Window.Resources>
        <!-- Компактный радиопереключатель: круг сразу слева от подписи (без раздвижки при Stretch). -->
        <Style x:Key="ThemeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Rf.Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="16" Height="16">
                                    <Ellipse x:Name="BulletOuter"
                                             Stroke="{DynamicResource Rf.Border}"
                                             StrokeThickness="1"
                                             Fill="Transparent"/>
                                    <Ellipse x:Name="BulletInner"
                                             Width="8" Height="8"
                                             Fill="{DynamicResource Rf.Accent}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BulletInner" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BulletOuter" Property="Stroke" Value="{DynamicResource Rf.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стрелки внутри общего поля с цифрой: без собственной рамки, только подсветка при наведении. -->
        <Style x:Key="Rf.Settings.SpinnerRepeatInline" TargetType="RepeatButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Delay" Value="400"/>
            <Setter Property="Interval" Value="75"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Rf.Text.Primary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rf.TitleBar.ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rf.Button.PressedBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
      Высота окна: SizeToContent=Height (по контенту, без полосы прокрутки).
      Ширина фиксирована (Width). ResizeMode=NoResize — без ручного растягивания.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Rf.Window.Background}"
            BorderBrush="{DynamicResource Rf.Border}"
            BorderThickness="1">
        <DockPanel>
            <!-- Заголовок -->
            <Border DockPanel.Dock="Top"
                    Height="44"
                    Background="{DynamicResource Rf.Surface}"
                    BorderBrush="{DynamicResource Rf.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            Padding="14,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_SettingsWindow_Header}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Rf.Text.Primary}"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="TitleBarAbout_OnMouseLeftButtonDown"/>
                                <Button Click="TitleBarAbout_OnClick"
                                        Style="{StaticResource Rf.TitleBar.AboutInfo}"/>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Rf.Text.Muted}"
                                       Text="{DynamicResource Loc_SettingsWindow_Subtitle}"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1"
                            Style="{StaticResource Rf.TitleBar.Close}"
                            Content="&#x00D7;"
                            ToolTip="{DynamicResource Loc_SettingsWindow_CloseWithoutSave}"
                            Click="TitleBarClose_OnClick"/>
                </Grid>
            </Border>

            <!-- Контент -->
            <Grid Margin="16,12,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Язык: подпись и список в одну линию -->
                    <Border Style="{StaticResource Rf.Settings.Card}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Content="{DynamicResource Loc_SettingsWindow_LanguageLabel}"
                                   Target="{Binding ElementName=LanguageCombo}"
                                   VerticalAlignment="Center"/>
                            <ComboBox x:Name="LanguageCombo"
                                      Grid.Column="2"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      DisplayMemberPath="NativeName"
                                      SelectedValuePath="Code"
                                      SelectionChanged="LanguageCombo_OnSelectionChanged"/>
                        </Grid>
                    </Border>

                    <!-- Запуск и окно -->
                    <Border Style="{StaticResource Rf.Settings.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rf.Settings.SectionTitle}" Text="{DynamicResource Loc_SettingsWindow_SectionStartup}"/>
                            <CheckBox x:Name="AutostartCheck"
                                      Margin="0,0,0,4"
                                      Content="{DynamicResource Loc_SettingsWindow_Autostart}"/>
                            <CheckBox x:Name="StartupToTrayCheck"
                                      Margin="0,4">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{DynamicResource Loc_SettingsWindow_StartupToTray}"/>
                            </CheckBox>
                            <CheckBox x:Name="TrayHideAnimationCheck"
                                      Margin="0,4">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{DynamicResource Loc_SettingsWindow_TrayAnimation}"/>
                            </CheckBox>
                            <CheckBox x:Name="CloseToTrayCheck"
                                      Margin="0,4">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{DynamicResource Loc_SettingsWindow_CloseToTrayCross}"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Авто-замер -->
                    <Border Style="{StaticResource Rf.Settings.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rf.Settings.SectionTitle}" Text="{DynamicResource Loc_SettingsWindow_SectionAutoMeasure}"/>
                            <CheckBox x:Name="AutoMeasureOnWindowOpenCheck"
                                      Margin="0,0,0,8"
                                      Content="{DynamicResource Loc_SettingsWindow_AutoMeasureOnWindowOpen}"/>
                            <CheckBox x:Name="AutoMeasureTrayStartupCheck"
                                      Margin="0,0,0,12"
                                      Content="{DynamicResource Loc_SettingsWindow_AutoMeasureTrayStartup}"/>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Rf.Text.Primary}"
                                           Text="{DynamicResource Loc_SettingsWindow_AutoMeasureDurationLabel}"/>
                                <Border Grid.Column="1"
                                        MinWidth="88"
                                        Height="32"
                                        CornerRadius="6"
                                        Background="{DynamicResource Rf.Surface}"
                                        BorderBrush="{DynamicResource Rf.Border}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DurationSecondsBox"
                                                 Grid.Column="0"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="6,0,2,0"
                                                 MinHeight="0"
                                                 VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 MaxLength="4"
                                                 ToolTip="{DynamicResource Loc_SettingsWindow_AutoMeasureDurationTooltip}"/>
                                        <Border Grid.Column="1"
                                                BorderBrush="{DynamicResource Rf.Border}"
                                                BorderThickness="1,0,0,0"
                                                Margin="0,4,4,4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="1"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <RepeatButton Grid.Row="0"
                                                              Style="{StaticResource Rf.Settings.SpinnerRepeatInline}"
                                                              Content="▲"
                                                              Click="DurationUp_OnClick"/>
                                                <Border Grid.Row="1"
                                                        Background="{DynamicResource Rf.Border}"
                                                        Height="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,-0.5,0,-0.5"/>
                                                <RepeatButton Grid.Row="2"
                                                              Style="{StaticResource Rf.Settings.SpinnerRepeatInline}"
                                                              Content="▼"
                                                              Click="DurationDown_OnClick"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                        <!-- Трей -->
                        <Border Style="{StaticResource Rf.Settings.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Rf.Settings.SectionTitle}" Text="{DynamicResource Loc_SettingsWindow_SectionTray}"/>
                                <StackPanel Margin="0,4,0,0">
                                    <RadioButton x:Name="TrayPairOpenSingle"
                                                 Style="{StaticResource ThemeRadioStyle}"
                                                 GroupName="TrayClickPair"
                                                 Content="{DynamicResource Loc_SettingsWindow_TrayClickOpenSingleQuickDouble}"
                                                 Margin="0,0,0,8"/>
                                    <RadioButton x:Name="TrayPairQuickSingle"
                                                 Style="{StaticResource ThemeRadioStyle}"
                                                 GroupName="TrayClickPair"
                                                 Content="{DynamicResource Loc_SettingsWindow_TrayClickQuickSingleOpenDouble}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                </StackPanel>

                <!-- Нижняя панель (верхний отступ 0 — расстояние до последней карточки задаёт Margin карточки 12, как между блоками) -->
                <Border Grid.Row="1"
                        Margin="0,0,0,16"
                        Padding="0,16,0,0"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Rf.Border}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Rf.Button}"
                                MinWidth="108"
                                Margin="0,0,10,0"
                                Padding="12,8"
                                Click="Cancel_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Rf.TextBlock.ProfileActionIcon}" Text="&#xE711;"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{DynamicResource Loc_SettingsWindow_Cancel}"
                                           Foreground="{DynamicResource Rf.Text.Primary}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Rf.Button.Accent}"
                                MinWidth="120"
                                Padding="12,8"
                                IsDefault="True"
                                Click="Save_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Rf.TextBlock.ProfileActionIcon}" Text="&#xE74E;"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{DynamicResource Loc_SettingsWindow_Save}"
                                           Foreground="{DynamicResource Rf.Accent}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
